# ===== 必填 =====
# 智谱开放平台 https://open.bigmodel.cn/ 的 API Key
ZHIPUAI_API_KEY=

# ===== 模型（一般不用改）=====
CHAT_MODEL=glm-4-flash
OPTIMIZE_MODEL=glm-4-flash   # chunk「AI 优化」用的模型，可换成 glm-4-plus 等更强档位
EMBED_MODEL=embedding-3
EMBED_DIM=2048

# ===== 检索调参 =====
TOP_K=6                     # 向量/BM25 各取前几条
RELEVANCE_GATE=true         # LLM 相关性把关：知识库外的问题不显示来源（多一次免费模型调用）

# ===== 切分调参（改完可用"重新入库"对已有文档重跑）=====
CHUNK_MAX_TOKENS=800          # 单块最大长度（近似字符数）
CHUNK_MERGE_PEERS=true        # 合并相邻小块

# ===== 文档转换 =====
OCR_ENABLED=false             # 有扫描件再开（会显著变慢）

# ===== 上传限制 =====
MAX_UPLOAD_MB=100
