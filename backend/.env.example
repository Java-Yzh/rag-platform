# ===== 模型配置 =====
# 模型（供应商/API Key/对话/向量/AI优化）已迁移到「设置」页面管理，存 SQLite。
# 本文件不再包含任何模型配置。

# ===== 检索调参 =====
TOP_K=6                     # 向量/BM25 各取前几条
RELEVANCE_GATE=true         # LLM 相关性把关：知识库外的问题不显示来源（多一次免费模型调用）

# ===== 切分调参（改完可在文档管理页"重新入库"，或设置页"全部重新入库"）=====
CHUNK_MAX_TOKENS=800          # 单块最大长度（近似字符数）
CHUNK_MERGE_PEERS=true        # 合并相邻小块

# ===== 文档转换 =====
OCR_ENABLED=false             # 有扫描件再开（会显著变慢）

# ===== 上传限制 =====
MAX_UPLOAD_MB=100
